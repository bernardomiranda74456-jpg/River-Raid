# Copie para .env (desenvolvimento) ou cadastre em `eas env:create` (builds).
# Valores públicos: vão para o bundle do app. A segurança vem das políticas RLS.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: domínio para links https de convite (precisa de AASA/assetlinks hospedados).
EXPO_PUBLIC_INVITE_BASE_URL=
# Opcional: links de instalação incluídos na mensagem de convite.
EXPO_PUBLIC_TESTFLIGHT_URL=
EXPO_PUBLIC_PLAY_URL=
